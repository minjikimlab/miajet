#!/bin/bash

#SBATCH --account=minjilab99 
#SBATCH --partition=standard 
#SBATCH --cpus-per-task=4
#SBATCH --mem=80g 
#SBATCH --gpus=0 
#SBATCH --profile=all
#SBATCH --time=6:00:00  
#SBATCH --mail-type=FAIL 
#SBATCH --output=slurm_out/slurm-%j.out

my_job_header

conda activate jet-env-rev

# Use the CHROM environment variable passed by the wrapper
python -m miajet /nfs/turbo/umms-minjilab/downloaded_data/HCT116_RAD21-auxin-6hr_intacthic_Guckelberger-2024_ENCFF317OIA_hg38.hic \
 --chrom "chr2" \
 --exp_type "hic" \
 --resolution 10000 \
 --window_size 1200000 \
 --normalization "VC_SQRT" \
 --verbose \
 --save_dir_root "/nfs/turbo/umms-minjilab/sionkim/miajet_revision/miajet/output_v2.0.1_test" \
 --num_cores 4 \

  


