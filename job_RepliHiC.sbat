#!/bin/bash

#SBATCH --account=minjilab99
#SBATCH --partition=standard 
#SBATCH --cpus-per-task=4
#SBATCH --mem=30g 
#SBATCH --gpus=0 
#SBATCH --profile=all
#SBATCH --time=8:00:00  
#SBATCH --mail-type=FAIL 
#SBATCH --output=slurm_out/slurm-%j.out

my_job_header

conda activate jet-env

# Use the CHROM environment variable passed by the wrapper
python -m miajet /nfs/turbo/umms-minjilab/downloaded_data/Repli-HiC_K562_WT_totalS.hic \
  --chrom "${CHROM}" \
  --exp_type "replihic" \
  --resolution 25000 \
  --window_size 6000000 \
  --save_dir_root "/nfs/turbo/umms-minjilab/sionkim/miajet_revision/miajet/output_v1.1.1_testcase" \
  --num_cores 4 \
  --verbose \
  --diagnostic_plots

  